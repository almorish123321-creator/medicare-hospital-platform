# ═══════════════════════════════════════════════════════════════════════════
#  Medicare Pro - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─── APP ───────────────────────────────────────────────────────────────
APP_NAME="Medicare Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Cairo
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ─── LOG ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_EXCEPTIONS_CHANNEL=stderr

# ─── DATABASE (MySQL) ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=medicare_pro
DB_USERNAME=medicare
DB_PASSWORD=secret

# ─── REDIS ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── SANCTUM ────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8080,localhost

# ─── BROADCAST (Soketi / Laravel Echo) ──────────────────────────────────
BROADCAST_DRIVER=soketi
BROADCAST_HOST=soketi
BROADCAST_PORT=6001

PUSHER_APP_ID=medicare-app
PUSHER_APP_KEY=medicare-key
PUSHER_APP_SECRET=medicare-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# ─── CACHE ─────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
CACHE_PREFIX=medicare_

# ─── QUEUE ──────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─── SESSION ────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost

# ─── MAIL (SMTP) ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── TWILIO (SMS & WhatsApp) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:

# ─── FCM (Firebase Cloud Messaging) ─────────────────────────────────────
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── STRIPE (Payments) ──────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── PAYMOB (Payments) ──────────────────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=

# ─── SWAGGER / L5-Swagger ───────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost/api/documentation

# ─── DOCKER ─────────────────────────────────────────────────────────────
DOCKER_APP_PORT=9000
DOCKER_NGINX_PORT=80
DOCKER_MYSQL_PORT=3306
DOCKER_REDIS_PORT=6379
DOCKER_PHPMYADMIN_PORT=8080
DOCKER_SOKETI_PORT=6001
DOCKER_SOKETI_METRICS_PORT=9601
