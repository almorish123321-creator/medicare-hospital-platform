{
  "app_id": "${PUSHER_APP_ID:-medicare-app}",
  "app_key": "${PUSHER_APP_KEY:-medicare-key}",
  "app_secret": "${PUSHER_APP_SECRET:-medicare-secret}",

  "port": 6001,
  "host": "0.0.0.0",

  "driver": "redis",
  "redis": {
    "host": "redis",
    "port": 6379,
    "db": 0
  },

  "channel_limits": {
    "max_name_length": 200,
    "max_channels_per_app": 100,
    "max_members_per_channel": 1000
  },

  "api": {
    "enabled": true,
    "port": 9601
  },

  "cors": {
    "origin": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["Authorization", "Content-Type", "X-Requested-With", "Accept", "Origin"],
    "exposed_headers": [],
    "credentials": true,
    "max_age": 600
  },

  "metrics": {
    "enabled": true,
    "driver": "redis",
    "redis": {
      "host": "redis",
      "port": 6379
    }
  }
}
