generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hospital {
  id          String   @id @default(cuid())
  name        String
  nameEn      String   @default("")
  location    String
  locationEn  String   @default("")
  phone       String   @default("")
  email       String   @default("")
  rating      Float    @default(0)
  image       String   @default("")
  departments Int      @default(0)
  doctors     Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departmentsList Department[]
  doctorsList     Doctor[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  nameEn     String   @default("")
  icon       String   @default("")
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctors Doctor[]
}

model Doctor {
  id           String   @id @default(cuid())
  name         String
  nameEn       String   @default("")
  specialty    String
  specialtyEn  String   @default("")
  phone        String   @default("")
  email        String   @default("")
  rating       Float    @default(0)
  experience   Int      @default(0)
  price        Float    @default(0)
  image        String   @default("")
  bio          String   @default("")
  bioEn        String   @default("")
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]
  schedules    Schedule[]
}

model Schedule {
  id        String   @id @default(cuid())
  day       String
  startTime String   @default("09:00")
  endTime   String   @default("17:00")
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  createdAt DateTime @default(now())
}

model Appointment {
  id         String   @id @default(cuid())
  patientName String
  patientPhone String
  patientEmail String  @default("")
  date       String
  time       String
  status     String   @default("pending")
  notes      String   @default("")
  doctorId   String
  doctor     Doctor   @relation(fields: [doctorId], references: [id])
  hospitalId String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id       String   @id @default(cuid())
  name     String
  email    String   @unique
  password String
  role     String   @default("patient")
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
